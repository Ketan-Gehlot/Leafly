# Leafly Frontend Environment Variables (Template)
# DO NOT put private keys, secrets, or server tokens here.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=leafly-c470f.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=leafly-c470f
VITE_FIREBASE_STORAGE_BUCKET=leafly-c470f.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Razorpay Public Key ID (Public Key only - NEVER put the Secret in the frontend)
VITE_RAZORPAY_KEY_ID=

# Local Emulator Support (set to true to use Firebase Emulator Suite)
VITE_USE_FIREBASE_EMULATOR=false
